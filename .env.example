# Copie para .env se quiser sobrescrever os padrões do docker-compose.yml
JWT_SECRET=troque-este-segredo-em-producao

# Read Access Token do TMDB (https://www.themoviedb.org/settings/api) —
# opcional: sem ele, trailer/elenco/"onde assistir" ficam desligados, o
# resto do site funciona normalmente. Ver README > Variáveis de ambiente.
TMDB_READ_TOKEN=
